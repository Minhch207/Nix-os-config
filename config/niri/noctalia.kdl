layout {

    focus-ring {
        active-color   "#eebd98"
        inactive-color "#161310"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#eebd98"
        inactive-color "#161310"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#eebd98"
        inactive-color "#613f23"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#eebd9880"
    }
}

recent-windows {
    highlight {
        active-color "#eebd98"
        urgent-color "#ffb4ab"
    }
}
